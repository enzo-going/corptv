# Serviço do agente CorporTV para Raspberry Pi / Linux.
#
# Numa Pi nova não instale à mão: use o comando que o painel mostra em cada
# tela (Telas → "Instalar numa Raspberry (TI)"). Ele instala este arquivo e cria a
# configuração do aparelho.
#
# Acompanhar:
#   journalctl -u corptv-agente -f
#
# A configuração do aparelho (servidor e tela) fica em /etc/corptv/agente.env,
# fora deste arquivo: atualizar o agente não apaga o que é de cada Pi.

[Unit]
Description=CorporTV - agente local (baixa e serve a midia)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Usuário próprio, criado pelo systemd só para o agente: funciona igual em
# qualquer Pi (usuário pi, ti ou outro), sem sudo e sem acesso ao resto do sistema.
DynamicUser=yes
# O cache (/var/lib/corptv) sobrevive ao reboot e pertence a esse usuário.
StateDirectory=corptv
WorkingDirectory=/opt/corptv-agente
ExecStart=/usr/bin/node /opt/corptv-agente/agente.js

# ── Padrões ──────────────────────────────────────────────────
Environment=CORPTV_PORTA=8080
Environment=CORPTV_CACHE=/var/lib/corptv/cache
# Ritmo do download, em Mb/s. Com 4 aparelhos: 4 x 2 = 8 Mb/s, abaixo do teto
# de 12 Mb/s do servidor. Aumentar só se a rede tiver folga sobrando.
Environment=CORPTV_LIMITE_MBPS=2
# Espalha o início do download em até 90s, para vários aparelhos que ligam
# juntos (queda de energia, por exemplo) não baixarem todos no mesmo instante.
Environment=CORPTV_JITTER=90
# Deste aparelho: CORPTV_SERVIDOR e CORPTV_TELA. Vale por cima dos padrões.
EnvironmentFile=/etc/corptv/agente.env

# Se cair, volta sozinho.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
